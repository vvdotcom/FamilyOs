FAMILYOS_DEMO_MODE=true
FAMILYOS_DEMO_NOW=2026-09-22T14:30:00-07:00

# Local-only account prototype. Codes are captured in the development outbox, never emailed.
FAMILYOS_AUTH_MODE=local
FAMILYOS_AUTH_DB_PATH=.familyos/familyos-auth.sqlite3
FAMILYOS_LOCAL_AUTH_SHOW_CODES=true
FAMILYOS_COOKIE_SECURE=false

# Railway production identity and persistence. Set these in Railway Variables, never in Git.
# The native iOS app uses the Cognito public app client and PKCE; the server validates ID tokens.
FAMILYOS_COGNITO_ISSUER=
FAMILYOS_COGNITO_CLIENT_ID=
DATABASE_URL=
FAMILYOS_CORS_ORIGINS=

FAMILYOS_API_URL=http://localhost:8787
EXPO_PUBLIC_FAMILYOS_API_URL=http://127.0.0.1:8787

FAMILYOS_AI_PROVIDER=deterministic

AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
FAMILYOS_BEDROCK_MODEL_ID=

# U.S. National Weather Service forecasts; no API key is required.
# Set a city-center latitude/longitude and display label for this deployment.
FAMILYOS_WEATHER_LATITUDE=
FAMILYOS_WEATHER_LONGITUDE=
FAMILYOS_WEATHER_LOCATION=
FAMILYOS_WEATHER_USER_AGENT=FamilyOS/0.1

# Optional Phase 11 external Google Calendar integration. Leave unset unless enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FAMILYOS_USE_DEMO_CALENDAR=true

# Phases 12-13 (optional). Public HTTPS URL of this service, used in MCP metadata.
FAMILYOS_PUBLIC_URL=
# Browser origins allowed to call /mcp (server-to-server clients such as Alexa+ send no Origin).
FAMILYOS_MCP_ALLOWED_ORIGINS=
# Cognito app client IDs whose OAuth access tokens may call /mcp (for Alexa+ account linking).
FAMILYOS_MCP_COGNITO_CLIENT_IDS=
# Chore photo checks: demo | bedrock. Defaults to FAMILYOS_AI_PROVIDER. Optional separate vision model.
FAMILYOS_VISION_PROVIDER=
FAMILYOS_BEDROCK_VISION_MODEL_ID=
FAMILYOS_VISION_CHECKS_PER_DAY=30
