{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "en-US": {
          "name": "Hometide",
          "summary": "Your family's calendar, chores, and pickups on the Fire TV you already own.",
          "description": "Ask Hometide what's on today, who's picking up the kids, or the weather at home, and tell it to open the calendar, chores, meals, or the wall calendar on your Fire TV. Changes like swapping a pickup wait for a parent to confirm on the TV or phone. Requires a Hometide account.",
          "examplePhrases": [
            "Alexa, open home tide",
            "Alexa, ask home tide to open the calendar",
            "Alexa, ask home tide what's the weather"
          ],
          "keywords": [
            "family",
            "calendar",
            "chores",
            "fire tv"
          ]
        }
      },
      "isAvailableWorldwide": false,
      "distributionCountries": [
        "US"
      ],
      "testingInstructions": "Link a Hometide account, pair a Fire TV running Hometide, then ask to open the calendar.",
      "category": "ORGANIZERS_AND_ASSISTANTS"
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "https://hometide.up.railway.app/alexa",
          "sslCertificateType": "Wildcard"
        },
        "interfaces": [
          {
            "type": "ALEXA_PRESENTATION_APL",
            "supportedViewports": [
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 1024,
                "maxWidth": 1279,
                "minHeight": 600,
                "maxHeight": 799
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 1280,
                "maxWidth": 1920,
                "minHeight": 800,
                "maxHeight": 1200
              },
              {
                "mode": "TV",
                "shape": "RECTANGLE",
                "minWidth": 960,
                "maxWidth": 960,
                "minHeight": 540,
                "maxHeight": 540
              }
            ]
          }
        ]
      }
    },
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": true,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false,
      "locales": {
        "en-US": {
          "privacyPolicyUrl": "https://hometide.up.railway.app/privacy"
        }
      }
    },
    "manifestVersion": "1.0"
  }
}
